  "suggesterModes": [
    {
      "id": "builtin-rediscover",
      "name": "Rediscover favorite recipes",
      "isBuiltin": true,
      "isDefault": false,
      "filters": [],
      "rules": [
        {
          "field": "lastMade",
          "direction": "favor-low"
        },
        {
          "field": "favourite",
          "direction": "favor-high"
        },
        {
          "field": "cookedCount",
          "direction": "favor-low"
        }
      ]
    },
    {
      "id": "builtin-go-to",
      "name": "My Go-to recipes",
      "isBuiltin": true,
      "isDefault": false,
      "filters": [],
      "rules": [
        {
          "field": "favourite",
          "direction": "favor-high"
        },
        {
          "field": "cookedCount",
          "direction": "favor-high"
        }
      ]
    },
    {
      "id": "builtin-find-new",
      "name": "Find new recipes",
      "isBuiltin": true,
      "isDefault": true,
      "filters": [],
      "rules": [
        {
          "field": "lastMade",
          "direction": "favor-none"
        },
        {
          "field": "favourite",
          "direction": "favor-low"
        },
        {
          "field": "cookedCount",
          "direction": "favor-none"
        }
      ]
    }
  ],
  "showHighGIWarnings": true,
  "giDictionary": "# High-glycemic foods (GI >= 70)\n# One regex pattern per line. Lines starting with # are comments.\n\n# Refined grains and rices\nwhite rice\njasmine rice\nshort.grain rice\ninstant rice\nrice flour\n\n# White bread products\nwhite bread\nbagel\nbaguette\nciabatta\nenglish muffin\nwhite roll\nwhite bun\nwhite pita\n\n# Crackers\nrice cake\nrice cracker\nwater cracker\ncracker\npretzel\n\n# Cereals\ncornflakes\ncorn flakes\nrice krispies\npuffed rice\ninstant oat\n\n# Sugars\n\\bsugar\\b\nbrown sugar\npowdered sugar\nconfectioner.s sugar\ncorn syrup\nhigh.fructose corn syrup\n\\bhfcs\\b\n\\bglucose\\b\n\\bdextrose\\b\n\\bmaltose\\b\ngolden syrup\nrice syrup\n\n# Other high-GI foods\ndonut\ndoughnut\n\\bsoda\\b\nwatermelon\n\\bdates\\b\nfrench fries\nmashed potato\nbaked potato",
